{
  "name": "personal-site",
  "description": "Personal portfolio site for Kaven Kim - Built with Next.js 15.5.2, TypeScript, and Tailwind CSS v4",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "author": {
    "name": "Kaven Kim",
    "role": "Technical Product Manager"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "type-check": "tsc --noEmit",
    "clean": "rm -rf .next",
    "clean-all": "rm -rf .next out dist *.tsbuildinfo .DS_Store",
    "dev-clean": "npm run clean && npm run dev",
    "build-analyze": "ANALYZE=true npm run build",
    "prod": "npm run build && npm run start",
    "prod-quick": "npm run start",
    "rebuild": "npm run clean && npm run build && npm run start",
    "reset": "npm run clean-all && npm ci && npm run build"
  },
  "dependencies": {
    "@mdx-js/loader": "^3.1.1",
    "@mdx-js/react": "^3.1.1",
    "@netlify/plugin-nextjs": "^5.12.1",
    "@next/mdx": "^15.5.2",
    "@tailwindcss/postcss": "^4.1.13",
    "date-fns": "^4.1.0",
    "gray-matter": "^4.0.3",
    "next": "^15.5.2",
    "next-mdx-remote": "^5.0.0",
    "postcss": "^8.5.6",
    "postcss-flexbugs-fixes": "^5.0.2",
    "postcss-preset-env": "^10.3.1",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "remark": "^15.0.1",
    "remark-html": "^16.0.1",
    "tailwindcss": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^24.3.1",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "autoprefixer": "^10.4.21",
    "typescript": "^5.9.2",
    "eslint": "^9",
    "eslint-config-next": "^15.5.2",
    "@eslint/eslintrc": "^3"
  },
  "engines": {
    "node": ">=22.0.0",
    "npm": ">=10.0.0"
  },
  "browserslist": [
    ">0.3%",
    "not ie 11",
    "not dead",
    "not op_mini all"
  ]
}
